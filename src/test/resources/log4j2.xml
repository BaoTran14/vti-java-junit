<?xml version="1.0" encoding="UTF-8"?>
<Configuration xmlns=""
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="">
    <Appenders>
        <!--        Config to print console-->
        <!--        name: config name. Needs to be referenced in <Loggers>-->
        <!--        PatternLayout: format log-->
        <Console name="CONSOLE">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%t] [%p] [%c] - %msg%n"/>
        </Console>
        <!--        Config to write log to file-->
        <!--        fileName: path to save file-->
        <!--        name: config name. Needs to be referenced in <Loggers>-->
        <!--        append: = false =>overwrite -->
                <RollingFile name="MAIN"
                             fileName="logs/main.log"
                             filePattern="logs/main-%d{yyyy-MM-dd}.log">
                    <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%t] [%p] [%c] - %msg%n"/>
                    <Policies>
                        <TimeBasedTriggeringPolicy interval="30" modulate="true"/>
                    </Policies>
                </RollingFile>
<!--        <File  name="MAIN" fileName="logs/main.log" append="false">-->
<!--            &lt;!&ndash;            %d: date time&ndash;&gt;-->
<!--            &lt;!&ndash;            %t: thread name&ndash;&gt;-->
<!--            &lt;!&ndash;            %p: log level name&ndash;&gt;-->
<!--            &lt;!&ndash;            %c: class name&ndash;&gt;-->
<!--            &lt;!&ndash;            %m: message&ndash;&gt;-->
<!--            <PatternLayout pattern="%d [%t] %p %c - %m%n"/>-->
<!--        </File >-->
    </Appenders>
    <Loggers>
        <!--        Set log level & call config <Appenders>-->
        <Root level="TRACE">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="MAIN"/>
        </Root>
        <!--        name: condition to call appender =>package name-->
<!--        <Logger name="vn.vti" level="DEBUG">-->
<!--            <AppenderRef ref="DEBUG_LOG"/>-->
<!--        </Logger>-->
    </Loggers>
</Configuration>